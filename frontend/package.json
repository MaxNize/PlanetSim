{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint 'src/**/*.{ts,tsx}' '*.config.{ts,js,cjs}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' '*.config.{ts,js,cjs}' --fix",
    "stylelint:fix": "stylelint 'src/**/*.css' --fix || true",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,md}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "fix": "npm run format && npm run lint:fix && npm run stylelint:fix || true"
  },
  "dependencies": {
    "markdownlint-cli2": "^0.23.1",
    "planet-sim-wasm": "file:../wasm/pkg",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "semantic-release": "25.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fallow": "latest",
    "globals": "^17.11.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "rollup": "^4.62.2",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "4.1.9"
  }
}
