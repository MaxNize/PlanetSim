{
    "name": "fortgeschrittene-programmierung",
    "private": true,
    "workspaces": [
        "frontend",
        "wasm"
    ],
    "scripts": {
        "setup": "npm --prefix frontend install",
        "build": "npm --prefix frontend run build && (cd wasm && cargo build --release)",
        "dev": "npm --prefix frontend run dev",
        "lint": "npm --prefix frontend run lint && (cd wasm && cargo clippy --all-targets -- -D warnings) && npm run lint:md",
        "lint:md": "markdownlint-cli2 'Docs/**/*.md' 'README.md' 'CONTRIBUTING.md'",
        "fix:md": "markdownlint-cli2 --fix 'Docs/**/*.md' 'README.md' 'CONTRIBUTING.md' || true",
        "fix:frontend": "npm --prefix frontend run fix || true",
        "fix": "npm run fix:frontend && npm run fix:md",
        "check:structure": "node scripts/check-structure.js",
        "check:max-lines": "node scripts/check-max-lines.js --exceptions max-lines-exceptions.json",
        "commit-lint": "commitlint --edit"
    },
    "devDependencies": {
        "@commitlint/cli": "19.3.0",
        "@commitlint/config-conventional": "19.2.2",
        "minimatch": "10.0.1",
        "glob": "11.0.0",
        "markdownlint-cli2": "0.13.0"
    }
}